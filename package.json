{
	"name": "parallax-effect-svelte",
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"prebuild": "sh bin/init-submodule.sh",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "svelte-kit sync && eslint . --max-warnings 0 && knip",
		"lint:fix": "svelte-kit sync && eslint . --fix --max-warnings 0 && knip",
		"shad": "pnpm dlx  shadcn-svelte@latest"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@lucide/svelte": "^1.63.0",
		"@sveltejs/adapter-vercel": "^7.0.1",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^22.20.5",
		"@vitejs/plugin-basic-ssl": "^2.3.0",
		"bits-ui": "^2.20.0",
		"clsx": "^2.1.1",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"knip": "^6.43.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svader": "^1.0.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"svelte2tsx": "^0.7.62",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"typescript": "^6",
		"typescript-eslint": "^8.72.0",
		"vite": "^8.3.5"
	},
	"dependencies": {
		"@sentry/sveltekit": "^11.8.0",
		"@sveltejs/enhanced-img": "^1.0.0",
		"@vercel/analytics": "^2.0.1",
		"@vercel/speed-insights": "^2.0.0",
		"mode-watcher": "^1.1.0",
		"vite-imagetools": "^12.0.1",
		"vite-plugin-devtools-json": "^1.1.2"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
